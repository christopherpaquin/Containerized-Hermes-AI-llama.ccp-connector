# Hermes Agent deployment configuration.
#
# deploy.sh copies this to .env automatically on first run (and keeps
# HERMES_UID/HERMES_GID in sync on every subsequent run). .env is
# gitignored -- edit it directly for local overrides, or edit this file
# to change the committed defaults for everyone.

# --- Hermes container image ---
# Published image: https://hub.docker.com/r/nousresearch/hermes-agent
# Pinned to an exact version tag -- never "latest" or "main" -- so upgrades
# are deliberate. Bump this and re-run ./deploy.sh to upgrade.
HERMES_IMAGE=nousresearch/hermes-agent
HERMES_IMAGE_TAG=v2026.8.13

# --- Host user mapping ---
# Overwritten automatically by deploy.sh from `id -u` / `id -g` so files
# Hermes writes under ~/.hermes stay owned by the invoking host user.
HERMES_UID=10000
HERMES_GID=10000

# --- llama.cpp endpoint ---
# llama-server already runs natively on this host. Must include /v1.
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# --- Model selection ---
# Leave empty to auto-detect from llama.cpp's /v1/models. If llama.cpp
# ever serves more than one model, set this to the exact model id you
# want Hermes to use (deploy.sh will otherwise warn and default to the
# first one returned).
HERMES_MODEL=

# --- Dashboard ---
# Bind address for the Hermes dashboard container. Keep 127.0.0.1 unless
# you have configured dashboard authentication below -- see README Security
# notes. Hermes refuses to start a non-loopback dashboard without one.
HERMES_DASHBOARD_HOST=127.0.0.1
HERMES_DASHBOARD_PORT=9119

# Required only if HERMES_DASHBOARD_HOST above is non-loopback (e.g.
# 0.0.0.0). deploy.sh refuses to proceed with a non-loopback bind unless
# both of these are set, and auto-generates
# HERMES_DASHBOARD_BASIC_AUTH_SECRET (session stability across restarts)
# the first time it's needed.
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- Gateway API server (optional) ---
# Exposes Hermes's own OpenAI-compatible endpoint (talks to the Hermes
# *agent* -- memory/skills/tools included -- not a passthrough to the local
# model). Off by default. deploy.sh auto-generates API_SERVER_KEY the first
# time API_SERVER_ENABLED is set to true. See README Security notes.
API_SERVER_ENABLED=false
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# API_SERVER_KEY=

# --- Slack platform (optional) ---
# All three required together -- without SLACK_ALLOWED_USERS, Hermes denies
# every Slack message as a safety default. Generate the app manifest with
# `docker exec hermes hermes slack manifest --agent-view --write`, create
# the app at https://api.slack.com/apps from that manifest, enable Socket
# Mode (app-level token, connections:write scope), install to your
# workspace (bot token), then find your Slack member ID from your profile.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=

# --- Backups (backup.sh) ---
# The backup archive contains real secrets (Slack tokens, API_SERVER_KEY,
# dashboard auth secret) -- keep it off any public/shared location.
# HERMES_BACKUP_DIR=~/hermes-backups
# HERMES_BACKUP_KEEP=14
# Optional: push a copy to another host you control via rsync, e.g.
# HERMES_BACKUP_REMOTE=cpaquin@viper.lab:/mnt/backups/hermes
# HERMES_BACKUP_REMOTE=
